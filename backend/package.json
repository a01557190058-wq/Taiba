{
  "name": "taiba-technology-school-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API and static hosting for Taiba Technology School website and admin dashboard",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/db-init.js",
    "db:seed": "node scripts/db-seed.js",
    "admin:init": "node scripts/create-admin.js",
    "setup": "node scripts/db-init.js && node scripts/create-admin.js && node scripts/db-seed.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:watch": "node --test --watch --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "multer": "^2.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
