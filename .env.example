# ---------------------------------------------------------------------------
# Taiba Technology School - environment template
# Copy this file to backend/.env and adjust the values. NEVER commit .env.
#   PowerShell:  Copy-Item .env.example backend/.env
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Public origin used for same-origin checks and absolute links (optional)
APP_ORIGIN=http://127.0.0.1:3000

# --- Database -------------------------------------------------------------
# Path is resolved relative to the backend/ directory unless absolute.
# The file is created automatically by `npm run db:init`.
DB_PATH=../database/taiba.sqlite

# --- Sessions -------------------------------------------------------------
# Required in production. In development a random secret is generated on each
# start (sessions are invalidated when the server restarts).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_HOURS=8

# Set to "true" only when the app is served over HTTPS behind a trusted proxy.
TRUST_PROXY=false

# --- Initial administrator (used by `npm run admin:init`) ------------------
# Leave ADMIN_PASSWORD empty to have a strong password generated and printed
# once by the script. Never commit real credentials.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@taiba.demo
ADMIN_PASSWORD=

# --- Rate limiting --------------------------------------------------------
LOGIN_RATE_LIMIT_MAX=10
APPLICATION_RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=15

# --- CORS -----------------------------------------------------------------
# Comma separated list of extra allowed origins. Empty = same-origin only.
ALLOWED_ORIGINS=
