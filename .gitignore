# Dependencies
node_modules/
package-lock.json.bak

# Environment / secrets
.env
.env.local
.env.*.local

# SQLite database and sidecar files
database/*.sqlite
database/*.sqlite-journal
database/*.sqlite-wal
database/*.sqlite-shm
database/*.db
backend/data/

# Logs and coverage
logs/
*.log
coverage/
.nyc_output/

# Test artifacts
backend/tests/.tmp/
.tmp/

# Uploaded news images (runtime data, not source)
uploads/news/*
!uploads/news/.gitkeep

# Uploaded gallery photos (runtime data, not source)
uploads/gallery/*
!uploads/gallery/.gitkeep

# Uploaded department covers/photos (runtime data, not source)
uploads/departments/*
!uploads/departments/.gitkeep

# Private admission documents - never committed, never publicly served
uploads/applications/*
!uploads/applications/.gitkeep

# React build output (generated by `npm run build` in frontend/)
frontend/dist/

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
